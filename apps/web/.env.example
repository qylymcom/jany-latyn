# Copy to .env and fill in as needed. Every value is optional.

# Branding shown in the UI. Uncomment to override the neutral defaults.
# PUBLIC_SITE_NAME=
# PUBLIC_SCRIPT_TITLE=
# PUBLIC_CONTACT_EMAIL=
# PUBLIC_SUPPORT_URL=
# PUBLIC_REPO_URL=

# Analytics. Leave both empty to send nothing (the default). The hosted
# testbed sets them; self-hosted and classroom deployments should not.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=
